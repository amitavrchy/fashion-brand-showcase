generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(CUSTOMER)
  orders       Order[]
  wishlist     WishlistItem[]
  createdAt    DateTime       @default(now())
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  heroImage   String
  season      String
  products    Product[]
}

model Product {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  description  String
  category     String
  fabric       String
  care         String
  price        Decimal        @db.Decimal(10, 2)
  collectionId String?
  collection   Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  media        ProductMedia[]
  variants     Variant[]
  lookHotspots LookHotspot[]
  wishlist     WishlistItem[]
  published    Boolean        @default(true)
  createdAt    DateTime       @default(now())
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  colorName String
  colorHex  String
  size      String
  stock     Int     @default(0)
}

model Lookbook {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  coverImage String
  chapters   LookChapter[]
}

model LookChapter {
  id         String        @id @default(cuid())
  lookbookId String
  lookbook   Lookbook      @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  imageUrl   String
  caption    String
  sortOrder  Int
  hotspots   LookHotspot[]
}

model LookHotspot {
  id        String      @id @default(cuid())
  chapterId String
  chapter   LookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  xPct      Float
  yPct      Float
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  email                 String
  status                OrderStatus @default(PENDING)
  total                 Decimal     @db.Decimal(10, 2)
  itemsJson             Json
  shippingJson          Json
  idempotencyKey        String      @unique
  paymentProvider       String      @default("MOCK")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?     @unique
  checkoutUrl           String?
  checkoutOrigin        String?
  expiresAt             DateTime?
  stockReleasedAt       DateTime?
  paidAt                DateTime?
  createdAt             DateTime    @default(now())
}

model Store {
  id      String @id @default(cuid())
  name    String
  city    String
  address String
  lat     Float
  lng     Float
  hours   String
}

model JournalPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  category    String
  body        String
  coverImage  String
  publishedAt DateTime @default(now())
}

model Campaign {
  id          String  @id @default(cuid())
  title       String
  subtitle    String
  image       String
  mobileImage String?
  link        String
  accent      String  @default("#5C1F1F")
  active      Boolean @default(true)
}

model SiteSettings {
  id                    String @id @default("main")
  announcement          String @default("Complimentary delivery on orders over €300")
  homeTitle             String @default("A wardrobe, considered.")
  homeDescription       String @default("Beautiful pieces. Natural materials. An ease that stays with you, season after season.")
  newsletterTitle       String @default("A letter from Lune.")
  newsletterDescription String @default("New collections, stories and small things worth sharing. A little inspiration, occasionally.")
  contactEmail          String @default("hello@atelierlune.example")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
